# Supabase Postgres (PostGIS enabled on the database) — used via drizzle-orm/postgres-js
DATABASE_URL=postgres://user:password@host:5432/postgres

# Upstash Redis (HTTP client — works over fetch, no persistent TCP connection)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret shared with Vercel Cron so /api/cron/* routes reject non-Vercel callers
CRON_SECRET=
